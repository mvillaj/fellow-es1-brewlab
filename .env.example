# Template for a gitignored `.env` at the repo root, which the server loads on
# start (--env-file-if-exists) and Vite reads via envDir. The two Clerk keys
# below are required; everything else has a working default.

# API
PORT=4000
BREWLAB_DB=server/data/brewlab.db

# Auth (Clerk). Both are required — the API rejects every request without the
# secret key, and the client refuses to boot without the publishable key.
# Get them from https://dashboard.clerk.com -> your app -> API keys, or run
# `npx clerk@latest auth login && npx clerk@latest env pull --file .env`.
# The publishable key is public by design; the secret key must never reach the
# client, which is why only the VITE_-prefixed one is exposed to the bundle.
# The publishable key is needed twice under two names: the API verifies session
# tokens with it, and Vite only exposes variables prefixed with VITE_ to the
# browser bundle. Same value in both.
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Fellow integration: "mock" (default, works offline) or "live"
FELLOW_MODE=mock
# FELLOW_API_BASE=https://l8qtmnc692.execute-api.us-west-2.amazonaws.com/v1

# Optional. Without it the two model-backed features (reading a bag, suggesting a
# profile) show as disabled and everything else works exactly as before.
# ANTHROPIC_API_KEY=sk-ant-...
