      "css": ".ds-field{display:flex;flex-direction:column;gap:5px;font-family:var(--sans);max-width:220px}.ds-field label{font-size:.78rem;letter-spacing:.04em;color:var(--text-dim)}.ds-hint{font-size:.75rem;color:var(--text-faint)}.ds-input{font:inherit;font-family:var(--mono);font-variant-numeric:tabular-nums;font-size:.92rem;background:var(--bg-raised);color:var(--text);border:1px solid var(--border-strong);border-radius:var(--radius-sm);padding:8px 10px;min-height:var(--control-h);transition:border-color .12s,box-shadow .12s}.ds-input:focus{outline:none;border-color:var(--crema-dim);box-shadow:0 0 0 3px var(--focus-ring)}"
    },
