      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:204px;padding:8px;background:var(--bg-raised);font-family:var(--sans)}.ds-nav-label{font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--text-faint);padding:14px 10px 6px}.ds-nav-link{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:var(--radius-sm);color:var(--text-dim);font-size:.92rem;text-decoration:none;transition:background .12s,color .12s}.ds-nav-link:hover{background:var(--surface);color:var(--text)}.ds-nav-link.on{background:var(--surface-2);color:var(--text);box-shadow:inset 2px 0 0 var(--crema)}.ds-nav-link:focus-visible{outline:none;box-shadow:0 0 0 3px var(--focus-ring)}.ds-nav-icon{width:18px;text-align:center;opacity:.9}"
    },
