      "css": ".ds-lockup{display:inline-block;font-size:2.4rem;color:var(--text)}.ds-bars{display:flex;align-items:flex-end;gap:.13em;height:.5em;margin-bottom:.24em}.ds-bars i{flex:1;background:var(--crema);border-radius:.09em}.ds-word{font-family:var(--display);font-weight:700;font-size:1em;line-height:1;text-transform:lowercase}"
