      "css": ".ds-btn-primary{font:inherit;font-family:var(--sans);font-size:.9rem;font-weight:600;padding:8px 14px;border-radius:var(--radius-sm);border:1px solid var(--crema);background:var(--crema);color:var(--on-accent);display:inline-flex;align-items:center;gap:8px}.ds-wbars{display:inline-flex;align-items:flex-end;gap:2px;height:.8em}.ds-wbars i{width:3px;height:100%;border-radius:1px;background:currentColor;transform:scaleY(.28);transform-origin:bottom;animation:ds-pull 1.05s ease-in-out infinite}.ds-wbars i:nth-child(2){animation-delay:.13s}.ds-wbars i:nth-child(3){animation-delay:.26s}.ds-wbars i:nth-child(4){animation-delay:.39s}@keyframes ds-pull{0%,100%{transform:scaleY(.28);opacity:.55}50%{transform:scaleY(1);opacity:1}}.ds-clock{font-family:var(--mono);font-size:.78em;font-variant-numeric:tabular-nums;opacity:.7}@media (prefers-reduced-motion:reduce){.ds-wbars i{animation:none;transform:scaleY(.62);opacity:.6}}"
    }
