{
  "name": "es1-brew-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Espresso brew tracker and profile studio for the Fellow Espresso Series 1",
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "pnpm --filter @brewlab/server dev",
    "dev:client": "pnpm --filter @brewlab/client dev",
    "build": "pnpm --filter @brewlab/client build",
    "typecheck": "tsc -p packages/shared && tsc -p server && tsc -p client",
    "test": "pnpm test:shared && pnpm test:server && pnpm test:client",
    "seed": "pnpm --filter @brewlab/server seed",
    "probe": "node scripts/fellow-probe.mjs",
    "reset": "rm -f server/data/brewlab.db server/data/brewlab.db-wal server/data/brewlab.db-shm && pnpm seed",
    "discover": "node scripts/fellow-discover.mjs",
    "har": "node scripts/fellow-har.mjs",
    "test:shared": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"packages/shared/src/*.test.ts\"",
    "test:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"server/src/**/*.test.ts\"",
    "test:client": "pnpm --filter @brewlab/client test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
