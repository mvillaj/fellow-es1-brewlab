{
  "name": "es1-brew-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Espresso brew tracker and profile studio for the Fellow Espresso Series 1",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "tsc -p packages/shared && tsc -p server && tsc -p client",
    "test": "npm run test:shared && npm run test:server",
    "seed": "npm run seed -w server",
    "probe": "node scripts/fellow-probe.mjs",
    "reset": "rm -f server/data/brewlab.db server/data/brewlab.db-wal server/data/brewlab.db-shm && npm run seed",
    "discover": "node scripts/fellow-discover.mjs",
    "har": "node scripts/fellow-har.mjs",
    "test:shared": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"packages/shared/src/*.test.ts\"",
    "test:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"server/src/**/*.test.ts\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
